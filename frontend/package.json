{
  "name": "tailadmin-react",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:ota": "npm run build:android:ota",
    "build:android:ota": "npm run build:android:web && npm run mobile:update:bundle",
    "build:web": "tsc -b && vite build",
    "build:android:web": "npm run mobile:version:check && tsc -b && vite build --mode android",
    "build:ios:web": "tsc -b && vite build --mode ios",
    "mobile:update:bundle": "node scripts/create-mobile-update.mjs",
    "mobile:update:keygen": "node scripts/generate-mobile-update-keys.mjs",
    "mobile:version:check": "node scripts/check-mobile-version.mjs",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug && cd .. && node scripts/publish-android-apk.mjs debug",
    "android:apk:release": "node scripts/check-android-signing.mjs && npm run android:sync && cd android && gradlew.bat assembleRelease && cd .. && node scripts/publish-android-apk.mjs release",
    "android:aab:release": "node scripts/check-android-signing.mjs && npm run android:sync && cd android && gradlew.bat bundleRelease",
    "android:open": "cap open android",
    "ios:sync": "npm run build:ios:web && cap sync ios && node scripts/normalize-ios-package-paths.mjs",
    "ios:open": "npm run ios:sync && cap open ios",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.0.0",
    "@capawesome/capacitor-live-update": "^8.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@heroicons/react": "^2.2.0",
    "@react-jvectormap/core": "^1.0.4",
    "@react-jvectormap/world": "^1.1.2",
    "@tanstack/react-query": "^5.100.9",
    "apexcharts": "^4.1.0",
    "axios": "^1.16.0",
    "clsx": "^2.1.1",
    "flatpickr": "^4.6.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "laravel-echo": "^2.4.0",
    "lucide-react": "^1.14.0",
    "pusher-js": "^8.6.0",
    "react": "^19.2.8",
    "react-apexcharts": "^1.7.0",
    "react-colorful": "^5.7.0",
    "react-datepicker": "^9.1.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.3.5",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.75.0",
    "react-router": "^8.3.0",
    "react-select": "^5.10.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@eslint/js": "^9.19.0",
    "@tailwindcss/postcss": "^4.0.8",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.6.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.8",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vite-plugin-svgr": "^4.3.0"
  },
  "overrides": {
    "react-helmet-async": {
      "react": "^16.8.0 || ^17 || ^18 || ^19"
    },
    "@react-jvectormap/core": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    },
    "@react-jvectormap/world": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    }
  }
}
