# URL API Laravel Traco, tanpa trailing slash.
TRACO_API_URL=http://127.0.0.1:8000/api
# Hasil satu-kali dari: php artisan mcp:client:create discord-agent
TRACO_MCP_API_KEY=

# stdio untuk proses lokal; http untuk remote Streamable HTTP.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3333
# Host header yang diizinkan, tanpa port; wajib disesuaikan bila di belakang reverse proxy.
MCP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Wajib pada mode HTTP. Dikirim client sebagai Authorization: Bearer <token>.
MCP_HTTP_BEARER_TOKEN=
# Origin yang boleh mengakses mode HTTP, dipisahkan koma. Kosong = request tanpa Origin saja.
MCP_ALLOWED_ORIGINS=

# Secret minimal 32 karakter yang dipakai gateway channel untuk menandatangani actor context.
DISCORD_ACTOR_SIGNING_SECRET=
# Guild yang diizinkan, dipisahkan koma. Untuk gateway di bawah, kosong akan
# otomatis dibatasi ke DISCORD_GUILD_ID. Kosong hanya berarti semua guild saat
# tidak ada DISCORD_GUILD_ID (misalnya MCP host non-Discord).
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ACTOR_MAX_TTL_SECONDS=300

# Gateway Discord non-AI untuk smoke test slash command.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Gunakan loopback bila bot dan MCP berjalan pada host yang sama.
TRACO_MCP_URL=http://127.0.0.1:3333/mcp

# Gateway Google Chat -> AI agent.
GOOGLE_CHAT_HOST=127.0.0.1
GOOGLE_CHAT_PORT=3443
GOOGLE_CHAT_PATH=/google-chat/events
GOOGLE_CHAT_AUDIENCE=https://chat.example.com/google-chat/events
GOOGLE_CHAT_AGENT_URL=http://127.0.0.1:8787/agent/google-chat
GOOGLE_CHAT_AGENT_BEARER_TOKEN=
GOOGLE_CHAT_AGENT_TIMEOUT_MS=25000

TRACO_REQUEST_TIMEOUT_MS=15000
# Batas defensif untuk mencegah payload/response besar menghabiskan memori.
MCP_MAX_REQUEST_BYTES=2097152
TRACO_MAX_RESPONSE_BYTES=8388608
TRACO_MAX_EXPORT_BYTES=20971520
LOG_LEVEL=info
