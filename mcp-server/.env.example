# URL API Laravel Traco, tanpa trailing slash.
TRACO_API_URL=http://127.0.0.1:8000/api
# Hasil satu-kali dari: php artisan mcp:client:create discord-agent
TRACO_MCP_API_KEY=

# stdio untuk proses lokal; http untuk remote Streamable HTTP.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3333
# Host header yang diizinkan, tanpa port; wajib disesuaikan bila di belakang reverse proxy.
MCP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Wajib pada mode HTTP. Dikirim client sebagai Authorization: Bearer <token>.
MCP_HTTP_BEARER_TOKEN=
# Origin yang boleh mengakses mode HTTP, dipisahkan koma. Kosong = request tanpa Origin saja.
MCP_ALLOWED_ORIGINS=

# Secret minimal 32 karakter yang juga dipakai Discord bot untuk menandatangani actor context.
DISCORD_ACTOR_SIGNING_SECRET=
# Guild yang diizinkan, dipisahkan koma. Kosong = semua guild.
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ACTOR_MAX_TTL_SECONDS=300

TRACO_REQUEST_TIMEOUT_MS=15000
LOG_LEVEL=info
